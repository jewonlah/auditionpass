# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@auditionpass.co.kr

# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 어드민 (39): 접근 허용 이메일 화이트리스트 (쉼표 구분) — 비어 있으면 /admin 전체 차단
ADMIN_EMAILS=

# 원클릭 지원 일일 쿼터 — 미설정·0 = 무제한. 트래픽 생기면 5로 켠다 (BM: 무료 5건/일)
APPLY_DAILY_LIMIT=
# AI 소개문 생성 (P2) — 미설정이면 기능이 조용히 꺼지고 수동 입력은 그대로 동작
DEEPSEEK_API_KEY=

# GA4 측정 ID (턴오버 계정 소유, 속성 '오디션패스') — 프로덕션에만 설정, 로컬은 비워 오염 방지
NEXT_PUBLIC_GA_ID=
