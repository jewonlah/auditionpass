# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@auditionpass.co.kr
# 비프로덕션 오발송 가드 — 운영(VERCEL_ENV=production)이 아니면 실제 수신자 대신 여기로 보낸다.
# 비어 있으면 발송을 생략하고 콘솔에 경고만 남긴다.
RESEND_TEST_TO=
# 비프로덕션에서 실제 수신자에게 그대로 보내야 하면 '1'로 설정(테스트 발송 용도로만 사용)
ALLOW_REAL_EMAIL=

# 어드민 (39): 접근 허용 이메일 화이트리스트 (쉼표 구분) — 비어 있으면 /admin 전체 차단
ADMIN_EMAILS=

# 원클릭 지원 일일 쿼터 — 미설정·0 = 무제한. 트래픽 생기면 5로 켠다 (BM: 무료 5건/일)
APPLY_DAILY_LIMIT=
# AI 소개문 생성 (P2) — 미설정이면 기능이 조용히 꺼지고 수동 입력은 그대로 동작
DEEPSEEK_API_KEY=

# GA4 측정 ID (턴오버 계정 소유, 속성 '오디션패스') — 프로덕션에만 설정, 로컬은 비워 오염 방지
NEXT_PUBLIC_GA_ID=

# Sentry 에러 모니터링 — DSN이 비어 있으면 초기화 자체를 건너뛴다(둘 다 채워야 동작)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# 소스맵 업로드용(선택) — 없으면 경고만 남기고 소스맵 업로드를 건너뛴다. 빌드는 항상 성공한다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
