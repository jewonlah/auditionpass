# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepSeek (V4-Flash) — description 정제용. platform.deepseek.com 에서 발급, 선불 충전식이라 잔액이 곧 지출 상한
# REFINE_ENABLED=1 이어야 실제로 호출됨 (0/미설정이면 규칙 기반 summarize 사용, 비용 0)
DEEPSEEK_API_KEY=your-deepseek-api-key
REFINE_ENABLED=1

# Instagram Graph API (자동 게시)
INSTAGRAM_ACCESS_TOKEN=your-instagram-long-lived-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# Threads API (자동 게시)
THREADS_ACCESS_TOKEN=your-threads-access-token
THREADS_USER_ID=your-threads-user-id

# 트랙 A-1 네이버 카페 — NAVER API HUB (console.ncloud.com > NAVER API HUB > Application > 인증 정보)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_CAFE_ENABLED=0
